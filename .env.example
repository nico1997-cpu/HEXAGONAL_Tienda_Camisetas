# ── Base de datos MySQL ──
MYSQL_DATABASE=camisas_tienda
MYSQL_ROOT_PASSWORD=admin
MYSQL_USER=tienda_user
MYSQL_PASSWORD=tienda_pass
MYSQL_PORT=3306

# ── Servidor API ──
SERVER_PORT=8080

# ── Seguridad JWT (clave secreta de al menos 32 caracteres y expiración en ms) ──
JWT_SECRET=este-es-un-secreto-seguro-de-al-menos-32-bytes-para-jwt
JWT_EXPIRATION=3600000

